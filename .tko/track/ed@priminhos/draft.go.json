            "label": "2026-06-08_23-54-50",
            "content": "package main\nimport \"fmt\"\n\nfunc ehPrimo(n int) bool {\n    if n < 2 {\n        return false\n    }\n\n    for i := 2; i*i <= n; i++ {\n        if n % i == 0 {\n            return false\n        }\n    }\n\n    return true\n}\n\nfunc primos(n int) []int {\n    var vet []int\n\n    for i := 2; n > 0; i++ {\n        if ehPrimo(i) {\n            vet = append(vet, i)\n            n--\n        }\n    }\n\n    return vet\n}\n\nfunc main() {\n    var n int\n    fmt.Scan(&n)\n\n    vet := primos(n)\n\n    fmt.Printf(\"[\")\n    for i := 0; i < len(vet); i++ {\n        if i == len(vet) - 1 {\n            fmt.Print(vet[i])\n            continue\n        }\n        fmt.Print(vet[i], \", \")\n    }\n    fmt.Println(\"]\")\n}\n",
